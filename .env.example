# Passwort für die Anmeldung (mindestens 10 Zeichen, am besten 20+)
APP_PASSWORD=bitte-ein-langes-passwort-waehlen

# Port, auf dem der Server lokal lauscht (der Reverse Proxy leitet dorthin weiter)
PORT=8080
HOST=127.0.0.1

# Wo Boards, Bilder und PDFs gespeichert werden
DATA_DIR=/var/lib/ideenmappe

# Wie lange eine Anmeldung gültig bleibt (Tage)
SESSION_DAYS=30

# Größenlimits
MAX_BOARD_MB=10
MAX_FILE_MB=50
